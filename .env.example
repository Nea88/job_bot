BOT_TOKEN=123456:ABC
# JSON list of Telegram user ids allowed to use admin commands
ADMIN_IDS=[123456789]

DB_URL=sqlite+aiosqlite:///data/job_bot.db
TIMEZONE=Europe/Moscow
COLLECT_INTERVAL_MINUTES=60
DAILY_INTERVIEW_HOUR=10

# hh.ru: User-Agent is mandatory; access token (dev.hh.ru app token) may be required
HH_USER_AGENT=MyJobBot/1.0 (your-real-email@domain)
HH_ACCESS_TOKEN=

# Telethon user account for reading vacancy channels (https://my.telegram.org)
TG_API_ID=
TG_API_HASH=
TG_SESSION=data/telethon

OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
OLLAMA_CONCURRENCY=1
OLLAMA_TIMEOUT=300
